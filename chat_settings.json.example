{
  "_comment": "このファイルを chat_settings.json にコピーしてから各パスを書き換えてください。",
  "model_path": "C:\\path\\to\\your\\model.gguf",
  "n_ctx": 8192,
  "max_tokens": 1024,
  "temperature": 0.7,
  "history_retention_days": 0,
  "n_threads_batch": 12,
  "n_batch": 1024,
  "n_ubatch": 512,
  "flash_attn": true,
  "offload_kqv": true,
  "use_mmap": true,
  "tts_enabled": false,
  "tts_rate": 0,
  "mic_enabled": false,
  "whisper_mode": "auto",
  "vad_threshold": 150,
  "system_prompt": "",
  "user_personalization": "",
  "response_language": "回答は必ず日本語のみで行ってください。",
  "reasoning_visibility_instruction": "内部の思考過程、分析、推論、計画は表示せず、ユーザーに見せる最終回答だけを出力してください。",
  "external_prompt_files": {
    "system_prompt": "",
    "user_personalization": "",
    "user_profile": "",
    "instructions": []
  },
  "vision_enabled": false,
  "vision_handler": "gemma4",
  "vision_projector_path": ""
}
